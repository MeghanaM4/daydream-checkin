# Airtable
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_base_id

# GitHub OAuth (for sign-in with GitHub)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Itch.io OAuth
ITCH_CLIENT_ID=your_itch_oauth_app_client_id

# Loops (for email verification)
LOOPS_API_KEY=your_loops_api_key
LOOPS_VERIFICATION_TRANSACTIONAL_ID=your_loops_verification_transactional_id # verification email transactional id
LOOPS_TICKET_TRANSACTIONAL_ID=your_loops_ticket_transactional_id # ticket email transactional id

# App configuration
PUBLIC_BASE_URL=http://localhost:5173
# (change to your production URL when deploying)
# DocuSeal embed URL for waiver (set to your form's public URL)
PUBLIC_DOCUSEAL_EMBED_URL=

# Session/cookie secret for securing checkin tokens
SESSION_SECRET=your_random_secret_key_for_sessions